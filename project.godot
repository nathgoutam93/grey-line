; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GreyLine"
run/main_scene="uid://bglb3r2wa4lrs"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://c13svdd1v10yw"

[autoload]

MaskViewProvider="*res://scripts/MaskViewProvider.gd"
MultiplayerSession="*res://scripts/network/multiplayer_session.gd"
NetworkTick="*res://scripts/network/network_tick_clock.gd"
WorldSnapshots="*res://scripts/network/world_snapshot_service.gd"
PlayerProfile="*res://scripts/profile/player_profile.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/occluder_from_collision/plugin.cfg", "res://addons/occluder_from_collisions/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

